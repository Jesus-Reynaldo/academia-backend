DATABASE_URL="mysql://root:@localhost:3306/academia"
PORT=3000

# Autenticación (obligatorio; usar un valor largo y aleatorio)
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS=3600

# Umbral de aprobación por defecto para el dashboard (0-100)
NOTA_APROBACION=51

# Cuentas de desarrollo que crea `npm run prisma:seed`.
# Si SEED_ADMIN_PASSWORD queda vacío, el seed genera una contraseña aleatoria y la muestra en consola.
SEED_ADMIN_EMAIL="admin@colegio.edu"
SEED_ADMIN_PASSWORD=""
